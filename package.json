{
  "name": "reborn-mark",
  "version": "2.8.2",
  "description": "Mark — Tauri 2 reborn build (frontend half: Vue 3 + muya from mark-electron@v1.2.3)",
  "private": true,
  "type": "module",
  "author": "xronocode",
  "homepage": "https://github.com/xronocode/mark",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck:ipc": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project chromium",
    "test:e2e:perf": "npm run build && playwright test --project webkit-perf",
    "test:e2e:ui": "playwright test --ui --project chromium",
    "release:preflight": "node tools/release-preflight.mjs",
    "release:materials": "node tools/release-materials.mjs",
    "release:governance": "node tools/release-governance.mjs",
    "release:github-controls": "node tools/release-github-controls.mjs",
    "release:project-sync": "node tools/release-project-sync.mjs",
    "release:notes": "node tools/release-notes.mjs",
    "release:normalize": "node tools/release-normalize.mjs",
    "release:readiness": "node tools/release-readiness.mjs",
    "release:train": "node tools/release-train.mjs",
    "safety:install": "python3 tools/security_gate.py install",
    "safety:test": "python3 -m unittest discover -s tests/security -p 'test_*.py'",
    "bench:launch": "node tools/bench-launch.mjs",
    "dev:smoke": "bash tools/dev-smoke.sh",
    "dev:check": "bash tools/dev-smoke.sh --check",
    "dev:quick": "bash tools/dev-smoke.sh --quick",
    "check:export-chunk": "node scripts/check-export-chunk.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@marktext/file-icons": "^1.0.6",
    "@octokit/rest": "^22.0.1",
    "@panzoom/panzoom": "4.6.2",
    "@popperjs/core": "^2.11.8",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "axios": "^1.20.0",
    "codemirror": "^5.65.19",
    "deep-equal": "^2.2.3",
    "diff-match-patch": "^1.0.5",
    "docx": "^9.14.0",
    "dom-autoscroller": "^2.3.4",
    "dompurify": "^3.4.17",
    "dragula": "^3.7.3",
    "element-plus": "^2.13.0",
    "element-resize-detector": "^1.2.4",
    "execall": "^3.0.0",
    "flowchart.js": "^1.18.1",
    "fuzzaldrin": "^2.1.0",
    "github-markdown-css": "^5.8.1",
    "html-tags": "^5.1.0",
    "iso-639-1": "^3.1.6",
    "joplin-turndown-plugin-gfm": "^1.0.12",
    "katex": "^0.18.2",
    "mitt": "^3.0.1",
    "path-browserify": "^1.0.1",
    "path-win32": "^1.0.1",
    "pele": "1.10.0",
    "pinia": "^3.0.4",
    "plist": "^3.1.1",
    "prismjs": "^1.30.0",
    "snabbdom": "^3.6.4",
    "snabbdom-to-html": "^7.1.0",
    "snapsvg-cjs": "^0.0.6",
    "turndown": "^7.2.2",
    "underscore": "^1.13.7",
    "vega-embed": "^7.1.0",
    "vega-interpreter": "^2.3.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.11.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^30.1.3",
    "postcss-preset-env": "^10.5.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.0",
    "vite-plugin-prismjs": "^0.0.11",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^4.1.12",
    "yaml": "2.8.3"
  }
}
