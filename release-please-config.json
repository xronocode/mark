{
  "$schema": "./node_modules/release-please/schemas/config.json",
  "bootstrap-sha": "3ad251f7cb613ec0e53be5a85a0983fba1d5fcaa",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "always-update": true,
  "skip-github-release": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "Continuous Integration",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "reborn-mark",
      "changelog-path": "CHANGELOG.md",
      "pull-request-title-pattern": "chore(release): v${version}",
      "pull-request-header": "This pull request was generated by the pinned Release Please CLI. It prepares repository release materials only; merging it does not create a tag or publish a release.",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "always-update": true,
      "skip-github-release": true
    }
  }
}
