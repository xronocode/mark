  <Testing>
    <module-level>
      <command-renderer>yarn unit -- --specs src/renderer/path/to/module.test.js</command-renderer>
      <command-rust>cargo test --manifest-path src-tauri/Cargo.toml -p mt-module</command-rust>
      <focus>Fast deterministic unit and contract checks close to the module</focus>
    </module-level>
    <wave-level>
      <command-renderer>yarn unit</command-renderer>
      <command-rust>cargo test --manifest-path src-tauri/Cargo.toml</command-rust>
      <focus>Checks merged surfaces touched by the wave; no full e2e</focus>
    </wave-level>
    <phase-level>
      <command-spec>yarn test:specs</command-spec>
      <command-unit>yarn unit</command-unit>
      <command-e2e>yarn e2e</command-e2e>
      <command-rust-full>cargo test --manifest-path src-tauri/Cargo.toml --all-features</command-rust-full>
      <command-smoke-install>
        brew install --cask marktext &amp;&amp; open -a MarkText &amp;&amp;
        sleep 2 &amp;&amp; pgrep -f MarkText
      </command-smoke-install>
      <focus>
        Full regression: CommonMark/GFM specs, unit, e2e, plus fresh-macOS
        install smoke test
      </focus>
    </phase-level>
    <mocking-policy>
      Prefer fakes over mocks. Filesystem operations use tempdirs (node:fs temp
      / tempfile crate). No network in unit tests. Tauri commands tested via
      tauri::test harness.
    </mocking-policy>
    <regression-policy>
      Every PR merge must keep test/specs/commonMark and test/specs/gfm fully
