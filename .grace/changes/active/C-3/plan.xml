    <ImplementationPlan>
      <T-001>
        <Title>muya getCopyData accessor</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>
            Muya.prototype.getCopyData returns { text } — the markdown of
            whatever is selected (DOM range via contentState
            getClipBoardData, table cells via the docCopyHandler-style
            export, image via token.raw) — and never touches the
            clipboard transport. (Widened after review-1 finding 1;
            see the spec GoalAddendum.)
          </Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>
            npx vitest run tests/renderer/muya/copy-data.test.js
          </Command>
        </Verification>
      </T-001>
      <T-002>
        <Title>Renderer command + editor handler</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>
            edit.copy-as-html emits bus copyAsHtmlRich after focus; the
            handler writes the selection payload via writeHtml, falls
            back to the whole document when nothing is selected, no-ops
            on an empty document, and falls back to muya copyAsRich on
            native write rejection.
          </Criterion>
          <Criterion>
            Handler registered on mount and unregistered on unmount.
          </Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>
            npx vitest run tests/renderer/commands/index-deep.test.js tests/renderer/components/editor-coverage.test.js
          </Command>
        </Verification>
      </T-002>
      <T-003>
        <Title>Native menu item + capability grant</Title>
        <DependsOn>T-002</DependsOn>
        <AcceptanceCriteria>
          <Criterion>
            Edit menu has "Copy as HTML" (edit.copy-as-html,
            CmdOrCtrl+Shift+C); both capability files grant
            clipboard-manager:allow-write-html.
          </Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>
            cargo test --manifest-path src-tauri/Cargo.toml --bin mark m009_menu
          </Command>
          <Command>
            npx vitest run tests/renderer/commands/menu-consistency.test.js
          </Command>
        </Verification>
      </T-003>
      <T-004>
        <Title>GRACE deltas and evidence</Title>
        <DependsOn>T-003</DependsOn>
        <AcceptanceCriteria>
          <Criterion>
            graph M-011/M-012 fn anchors added; verification V-M-009/11/12
            scenarios + command updated; grace lint clean for C-3.
          </Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>grace lint --path . --assertions current</Command>
          <Command>grace status --path . --with modules --json</Command>
        </Verification>
      </T-004>
    </ImplementationPlan>
  </C-3>
