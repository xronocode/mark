    <ObservedWriteScope>
      <File>tools/security_gate.py</File>
      <File>tests/security/test_security_gate.py</File>
      <File>docs/commit-push-safety.md</File>
      <File>.grace/graph/index.xml</File>
      <File>.grace/graph/features.xml</File>
      <File>.grace/verification/index.xml</File>
      <File>.grace/verification/features.xml</File>
      <Glob>.grace/changes/active/C-SAFE-PUBLIC-GITHUB-REFERENCES/**</Glob>
    </ObservedWriteScope>
