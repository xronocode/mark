        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>Documentation, graph, verification and tests describe the same narrow rule; the real release candidate passes two local-model reviews without override.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>grace lint --path . --assertions current</Command>
          <Command>python3 tools/security_gate.py review-staged --message 'fix(release): close automation gaps'</Command>
        </Verification>
      </T-002>
    </ImplementationPlan>
  </C-SAFE-PUBLIC-GITHUB-REFERENCES>
