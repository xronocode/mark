    <IntentSummary>Refine M-064's untrusted-payload review contract so public GitHub resource and runtime-lookup references are not confused with literal secrets, while every byte and existing fail-closed gate remains intact.</IntentSummary>
    <BaselineAssertions>
      <MustContain>
        <File>tools/security_gate.py</File>
        <Text>Public source hashes, public repository URLs, ordinary relative paths, portable placeholders</Text>
      </MustContain>
      <MustContain>
        <File>tools/security_gate.py</File>
        <Text>Gitleaks and deterministic path/artifact checks have already passed.</Text>
      </MustContain>
      <MustExist>tests/security/test_security_gate.py</MustExist>
    </BaselineAssertions>
    <TargetAssertions>
      <MustVerify>
        <Module>M-064</Module>
      </MustVerify>
      <MustContain>
        <File>tools/security_gate.py</File>
        <Text>GitHub GraphQL node IDs</Text>
      </MustContain>
      <MustContain>
        <File>docs/commit-push-safety.md</File>
        <Text>symbolic GitHub Actions expressions</Text>
      </MustContain>
      <MustPassCommand>
        <Command budgetSeconds="180">python3 -m unittest discover -s tests/security -p 'test_*.py'</Command>
      </MustPassCommand>
      <MustPassCommand>
        <Command budgetSeconds="30">git diff --check</Command>
      </MustPassCommand>
    </TargetAssertions>
    <DurableScope>
      <GraphAnchors>
        <M-064 />
      </GraphAnchors>
      <VerificationAnchors>
        <V-M-064 />
