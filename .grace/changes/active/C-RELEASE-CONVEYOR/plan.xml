<GraceChangePlan graceVersion="4.0" status="approved"><C-RELEASE-CONVEYOR>
  <Name>Release conveyor without loops — implementation plan</Name><Created>2026-10-24</Created><Spec>C-RELEASE-CONVEYOR</Spec>
  <IntentSummary>
    Remove the five release-conveyor loops found in the 2026-10-24 audit at their causes — count-based seal span, two version authorities, hardcoded train IDs, live-version test fixtures, and the exact-tip approval binding — and close out the 2.8.x-next train, without weakening any trust boundary.
  </IntentSummary>
  <BaselineAssertions>
    <MustExist><Value>tools/release-readiness.mjs</Value></MustExist>
    <MustExist><Value>.github/workflows/promote-release.yml</Value></MustExist>
    <MustContain><File>.github/workflows/promote-release.yml</File><Text>environment: release-authorize</Text></MustContain>
  </BaselineAssertions>
  <TargetAssertions>
    <MustExist><Value>tools/release-train.mjs</Value></MustExist>
    <MustExist><Value>docs/release-trains/current.json</Value></MustExist>
    <MustContain><File>tools/release-readiness.mjs</File><Text>BLOCK_VALIDATE_SEAL_SPAN</Text></MustContain>
    <MustContain><File>.github/workflows/promote-release.yml</File><Text>git merge-base --is-ancestor "$SEAL" origin/main</Text></MustContain>
    <MustContain><File>.github/workflows/release.yml</File><Text>BLOCK_RELEASE_LATEST_ADVANCED</Text></MustContain>
    <MustContain><File>tests/renderer/release-readiness.test.js</File><Text>rejects a product commit inside the span even when a later commit reverts it</Text></MustContain>
    <MustContain><File>tests/renderer/release-train.test.js</File><Text>leaves no hardcoded train ID in release workflows and tools</Text></MustContain>
  </TargetAssertions>
  <DurableScope><GraphAnchors><M-046/></GraphAnchors><VerificationAnchors><V-M-046/></VerificationAnchors></DurableScope>
  <ObservedWriteScope>
