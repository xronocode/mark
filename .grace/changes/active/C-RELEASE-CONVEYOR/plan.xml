  <ImplementationPlan>
    <T-001>
      <Title>Current-train pointer (L3)</Title>
      <DependsOn></DependsOn>
      <AcceptanceCriteria><Criterion>tools/release-train.mjs resolves docs/release-trains/current.json, rejects malformed/traversing IDs, prints a path or field; all release workflows and tools use it.</Criterion></AcceptanceCriteria>
      <Verification><Command>npx vitest run tests/renderer/release-train.test.js</Command></Verification>
    </T-001>
    <T-002>
      <Title>Commit-wise seal span and seal-on-main binding (L1, L5)</Title>
      <DependsOn>T-001</DependsOn>
      <AcceptanceCriteria><Criterion>validateSealSpan proves each span commit bookkeeping-only; promote preflight/authorize use merge-base ancestry; governance holds release-bearing merges only while Preparing/Frozen.</Criterion></AcceptanceCriteria>
      <Verification><Command>npx vitest run tests/renderer/release-readiness.test.js tests/renderer/release-governance.test.js tests/renderer/release-github-controls.test.js</Command></Verification>
    </T-002>
    <T-003>
      <Title>Single version authority (L2)</Title>
      <DependsOn>T-001</DependsOn>
      <AcceptanceCriteria><Criterion>Release Please files, dependency and close job removed; normalize reads package.json only; publish proves releases/latest advanced.</Criterion></AcceptanceCriteria>
      <Verification><Command>npx vitest run tests/renderer/release-normalize.test.js</Command></Verification>
    </T-003>
    <T-004>
      <Title>Version-independent tests (L4)</Title>
      <DependsOn>T-002, T-003</DependsOn>
      <AcceptanceCriteria><Criterion>normalize suite synthetic; materials/readiness suites derive version and train from the repository.</Criterion></AcceptanceCriteria>
      <Verification><Command>npx vitest run</Command></Verification>
    </T-004>
    <T-005>
      <Title>Train close-out and protocol docs</Title>
      <DependsOn>T-001</DependsOn>
      <AcceptanceCriteria><Criterion>2.8.x-next Released with evidence; 2.9.x-next Collecting; README protocol, AGENTS release steps, M-046 graph and V-M-046 verification updated.</Criterion></AcceptanceCriteria>
      <Verification><Command>npm run release:readiness -- --tag v2.9.0</Command><Command>grace lint --path . --assertions current</Command></Verification>
    </T-005>
  </ImplementationPlan>
</C-RELEASE-CONVEYOR></GraceChangePlan>
