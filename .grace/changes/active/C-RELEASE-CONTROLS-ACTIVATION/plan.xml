<GraceChangePlan graceVersion="4.0" status="approved">
  <C-RELEASE-CONTROLS-ACTIVATION>
    <ChangeRef>C-RELEASE-CONTROLS-ACTIVATION</ChangeRef>
    <Created>2026-10-21</Created>
    <IntentSummary>Make explicit ruleset activation execute, journal, and verify its active target without changing the safe disabled staging contract.</IntentSummary>
    <BaselineAssertions>
      <MustContain>
        <File>.github/release-governance.json</File>
        <Text>"activeEnforcement": "active"</Text>
      </MustContain>
      <MustContain>
        <File>.github/release-governance.json</File>
        <Text>"enforcement": "disabled"</Text>
      </MustContain>
    </BaselineAssertions>
    <TargetAssertions>
      <MustVerify>
        <Module>M-046</Module>
      </MustVerify>
      <MustContain>
        <File>tools/release-github-controls.mjs</File>
        <Text>mode === 'apply' || mode === 'activate'</Text>
      </MustContain>
      <MustContain>
        <File>tools/release-github-controls.mjs</File>
        <Text>BLOCK_RELEASE_CONTROLS_ACTIVE_CONFIRMED</Text>
      </MustContain>
      <MustPassCommand>
        <Command budgetSeconds="180">npx vitest run tests/renderer/release-github-controls.test.js</Command>
      </MustPassCommand>
      <MustPassCommand>
        <Command budgetSeconds="180">npm run release:governance</Command>
      </MustPassCommand>
      <MustPassCommand>
        <Command budgetSeconds="30">git diff --check</Command>
      </MustPassCommand>
    </TargetAssertions>
    <DurableScope>
      <GraphAnchors>
        <M-046 />
      </GraphAnchors>
      <VerificationAnchors>
        <V-M-046 />
      </VerificationAnchors>
    </DurableScope>
    <ObservedWriteScope>
      <File>tools/release-github-controls.mjs</File>
      <File>tests/renderer/release-github-controls.test.js</File>
      <File>docs/release-trains/README.md</File>
      <File>.grace/verification/features.xml</File>
      <Glob>.grace/changes/active/C-RELEASE-CONTROLS-ACTIVATION/**</Glob>
    </ObservedWriteScope>
    <ImplementationPlan>
      <T-001>
        <Title>Execute and verify activation</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Activate is a mutating reconcile mode, retains bounded convergence and per-operation read-back, and emits success only after both active rulesets converge.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>npx vitest run tests/renderer/release-github-controls.test.js</Command>
        </Verification>
      </T-001>
      <T-002>
        <Title>Separate staged and active read-only checks</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>The rollout runbook uses staged check before activation and active-state check afterward; active verification rejects the disabled staging state.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>npm run release:github-controls -- --check-active</Command>
        </Verification>
      </T-002>
      <T-003>
        <Title>Apply live controls and read back exact enforcement</Title>
        <DependsOn>T-002</DependsOn>
        <AcceptanceCriteria>
          <Criterion>Both managed GitHub rulesets report active through the API and the active-state command reports zero drift.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>gh api repos/xronocode/mark/rulesets</Command>
          <Command>grace lint --path . --assertions current</Command>
        </Verification>
      </T-003>
    </ImplementationPlan>
  </C-RELEASE-CONTROLS-ACTIVATION>
</GraceChangePlan>
