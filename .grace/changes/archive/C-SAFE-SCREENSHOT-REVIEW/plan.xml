<GraceChangePlan graceVersion="4.0" status="applied">
  <C-SAFE-SCREENSHOT-REVIEW>
    <ChangeRef>C-SAFE-SCREENSHOT-REVIEW</ChangeRef>
    <IntentSummary>Extend M-064 with one exact-byte, manifest-bound human-review lane for release README PNGs while preserving the fail-closed static, local-model, identity, hook, and outgoing-history controls.</IntentSummary>
    <BaselineAssertions>
      <MustContain>
        <File>tools/security_gate.py</File>
        <Text>Binary requires separate local multimodal review</Text>
      </MustContain>
      <MustContain>
        <File>docs/commit-push-safety.md</File>
        <Text>Binary additions are blocked</Text>
      </MustContain>
      <MustContain>
        <File>.grace/graph/features.xml</File>
        <Text>&lt;M-064&gt;</Text>
      </MustContain>
      <MustContain>
        <File>.grace/verification/features.xml</File>
        <Text>&lt;V-M-064&gt;</Text>
      </MustContain>
    </BaselineAssertions>
    <TargetAssertions>
      <MustContain>
        <File>tools/security_gate.py</File>
        <Text>validate_reviewed_screenshot_binaries</Text>
      </MustContain>
      <MustContain>
        <File>docs/commit-push-safety.md</File>
        <Text>manifest-bound README screenshots</Text>
      </MustContain>
      <MustPassCommand>
        <Command>python3 -m unittest discover -s tests/security -p 'test_*.py'</Command>
      </MustPassCommand>
      <MustPassCommand>
        <Command>npx vitest run tests/renderer/release-materials.test.js</Command>
      </MustPassCommand>
    </TargetAssertions>
    <DurableScope>
      <GraphAnchors>
        <M-064 />
      </GraphAnchors>
      <VerificationAnchors>
        <V-M-064 />
      </VerificationAnchors>
      <GraphDocuments>
        <GD-FEATURES />
      </GraphDocuments>
      <VerificationDocuments>
        <VD-FEATURES />
      </VerificationDocuments>
    </DurableScope>
    <ObservedWriteScope>
      <File>.grace/changes/active/C-SAFE-SCREENSHOT-REVIEW/spec.xml</File>
      <File>.grace/changes/active/C-SAFE-SCREENSHOT-REVIEW/plan.xml</File>
      <File>tools/security_gate.py</File>
      <File>tests/security/test_security_gate.py</File>
      <File>docs/commit-push-safety.md</File>
      <File>.grace/graph/features.xml</File>
      <File>.grace/verification/features.xml</File>
    </ObservedWriteScope>
    <ImplementationPlan>
      <T-001>
        <Title>Validate manifest-bound reviewed screenshot binaries</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Parse candidate manifests without trusting the worktree, require exact unique README PNG membership, PNG signature, lowercase SHA-256 identity, and complete fresh human-review metadata, then exclude only those proven blobs from the text-only rejection path.</Criterion>
          <Criterion>All other binary, non-UTF-8, private, generated, credential, lane, Gitleaks, local-model, and candidate-recheck controls retain their current behavior.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>python3 -m unittest discover -s tests/security -p 'test_*.py'</Command>
        </Verification>
      </T-001>
      <T-002>
        <Title>Synchronize safety contracts and release-material evidence</Title>
        <DependsOn>T-001</DependsOn>
        <AcceptanceCriteria>
          <Criterion>M-064, V-M-064, the operator protocol, and regression tests describe the exact-byte review boundary and fail-closed negative cases.</Criterion>
          <Criterion>The existing release-materials digest validator remains green and no release-product behavior changes.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>npx vitest run tests/renderer/release-materials.test.js</Command>
          <Command>grace lint --path . --change C-SAFE-SCREENSHOT-REVIEW --assertions target</Command>
        </Verification>
      </T-002>
    </ImplementationPlan>
  </C-SAFE-SCREENSHOT-REVIEW>
</GraceChangePlan>
