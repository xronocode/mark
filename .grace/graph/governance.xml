          </Input>
        </Inputs>
        <Outputs>
          <Output>
            <Name>methodology</Name>
            <Type>docs/grace-ai-standards-hygiene-methodology.md</Type>
          </Output>
          <Output>
            <Name>policyRules</Name>
            <Type>Context modes, precedence rules, escalation rules</Type>
          </Output>
        </Outputs>
        <Errors>
          <Error>
            <Code>GH_CONTRACT_BYPASS</Code>
          </Error>
          <Error>
            <Code>GH_VERIFICATION_SKIPPED</Code>
          </Error>
          <Error>
            <Code>GH_CONTEXT_UNDERLOAD</Code>
          </Error>
        </Errors>
      </Contract>
      <Interface>
        <fn-select_context_mode>
          <LegacyAttributes>
            <Attribute>
              <Name>PURPOSE</Name>
              <Value>Choose targeted, wave, or full context using dependency and risk triggers</Value>
            </Attribute>
          </LegacyAttributes>
        </fn-select_context_mode>
        <fn-enforce_precedence>
          <LegacyAttributes>
            <Attribute>
              <Name>PURPOSE</Name>
              <Value>
