# Byte-exact markdown corpus for the muya round-trip and tokenizer-parity
# goldens (C-24). Windows runners check out with core.autocrlf=true, which
# turned these into CRLF and failed 13 tests; pin LF in every checkout.
tests/renderer/muya/fixtures/** text eol=lf
# C-33: icon sources are hashed (Assets.car.sources.sha256) and compared to
# gen.py output byte for byte — keep LF on every checkout.
assets/icon/** text eol=lf
# The retained synthetic preference examples are byte-hashed by the public
# privacy guard. Windows checkout conversion must not change those bytes.
fixtures/**/migration-relevant/*.json text eol=lf
fixtures/fixture-pin.lock text eol=lf
# Node scripts with a shebang are imported by vitest; a CRLF checkout
# breaks the shebang line, so keep tools scripts LF on every checkout.
tools/*.mjs text eol=lf

# C-LARGE-DOC-STAGE-0: the corpus is byte-pinned (sha256 in shape-metadata.json);
# no EOL conversion on any platform — checkout must yield the committed bytes
tests/e2e/fixtures/large-doc/** -text
