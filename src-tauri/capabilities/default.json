{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main Mark window. Grants core:event:default so @tauri-apps/api event listeners work, plus all custom mt_* commands.",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:path:default",
    "core:app:default",
    "updater:default",
    "global-shortcut:default",
    "dialog:default",
    "window-state:default",
    "opener:default",
    "core:webview:allow-set-webview-zoom"
  ]
}
