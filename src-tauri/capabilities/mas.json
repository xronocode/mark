{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mas",
  "description": "Mac App Store capability — same as default but without updater plugin.",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:path:default",
    "core:app:default",
    "global-shortcut:default",
    "dialog:default",
    "window-state:default",
    "opener:default",
    "core:webview:allow-set-webview-zoom"
  ]
}
